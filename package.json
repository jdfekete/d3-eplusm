{
  "name": "d3-eplusm",
  "version": "0.0.3-dev",
  "description": "Exponent plus Mantissa scale for d3.",
  "keywords": [
    "d3",
    "d3-module",
    "scale",
    "visualization",
    "es6"
  ],
  "homepage": "https://github.com/jdfekete/d3-eplusm",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/jdfekete/d3-eplusm.git"
  },
  "module": "src/index.js",
  "main": "src/index.js",
  "jsdelivr": "dist/d3-eplusm.min.js",
  "unpkg": "dist/d3-eplusm.min.js",
  "exports": {
    "umd": "./dist/d3-eplusm.min.js",
    "default": "./src/index.js"
  },
  "author": "Jean-Daniel Fekete",
  "scripts": {
    "build": "rollup -c",
    "pretest": "yarn build",
    "test": "TZ=America/Los_Angeles mocha 'test/**/*-test.js' && eslint src",
    "clean": "rm -rf node_modules dist",
    "prettier": "prettier --write '{src,test}/**/*.js'",
    "start": "web-dev-server --node-resolve --open examples/ticks.html --watch"
  },
  "type": "module",
  "files": [
    "dist/**/*.js",
    "src/**/*.js"
  ],
  "dependencies": {
    "d3-array": "2.10.0 - 3",
    "d3-format": "1 - 3",
    "d3-scale": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.28.0",
    "@rollup/plugin-dsv": "^3.0.5",
    "@rollup/plugin-terser": "*",
    "@web/dev-server": "^0.4.6",
    "d3-color": "1 - 3",
    "d3-interpolate": "1.2.0 - 3",
    "eslint": "*",
    "globals": "^16.2.0",
    "jsonfile": "*",
    "mocha": "11",
    "parse-path": "*",
    "prettier": "*",
    "rollup": "2"
  },
  "license": "MIT",
  "engines": {
    "node": ">=12"
  },
  "prettier": {
    "singleQuote": true
  },
  "directories": {
    "test": "test"
  },
  "bugs": {
    "url": "https://github.com/jdfekete/d3-eplusm/issues"
  }
}
